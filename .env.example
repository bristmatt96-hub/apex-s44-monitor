# ============================================
# Credit Catalyst — Environment Variables
# ============================================

# Anthropic Claude API (for analyst agent)
# Get key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI (optional, for embeddings)
OPENAI_API_KEY=your_openai_api_key

# ============================================
# EUROPEAN REGULATORY MONITORING
# ============================================

# UK Companies House API (FREE)
# Register at: https://developer.company-information.service.gov.uk/
# Rate limit: 600 requests per 5 minutes
COMPANIES_HOUSE_API_KEY=your_companies_house_api_key

# ============================================
# NOTIFICATIONS
# ============================================

# Telegram (for credit event alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ============================================
# SUBSTACK EMAIL PARSER
# ============================================
SUBSTACK_EMAIL=your_email@example.com
SUBSTACK_EMAIL_PASSWORD=your_app_password
