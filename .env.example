# ============================================
# Credit Catalyst - Environment Variables
# ============================================

# AI/LLM
ANTHROPIC_API_KEY=your_anthropic_api_key

# Database
DATABASE_URL=sqlite:///data/credit_catalyst.db

# ============================================
# TELEGRAM ALERTS
# ============================================
# 1. Create a new bot via @BotFather on Telegram
# 2. Create a channel/group for credit alerts
# 3. Add the bot as admin
# 4. Get chat ID: send message, then visit https://api.telegram.org/bot<TOKEN>/getUpdates

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ============================================
# DATA SOURCES
# ============================================

# News API (newsapi.org)
NEWSAPI_KEY=your_newsapi_key

# Twitter/X (for social sentiment)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Finnhub (company news, filings, sentiment)
FINNHUB_API_KEY=your_finnhub_api_key

# ============================================
# EUROPEAN REGULATORY MONITORING
# ============================================

# UK Companies House API (FREE)
# Register at: https://developer.company-information.service.gov.uk/
# Rate limit: 600 requests per 5 minutes
COMPANIES_HOUSE_API_KEY=your_companies_house_api_key

# Note: UK RNS feed, ESMA OAMs, DGAP, AMF are publicly accessible
# ESAP (European Single Access Point) coming July 2027

# ============================================
# OPTIONAL
# ============================================

# Redis (for caching)
REDIS_URL=redis://localhost:6379/0

# Debug mode
DEBUG=false
LOG_LEVEL=INFO
