# ============================================
# APEX S44 Monitor — Environment Variables
# ============================================
# Copy to .env and fill in your keys.
# .env is gitignored — never committed.

# ============================================
# LLM PROVIDERS (pick one)
# ============================================

# Option A: Chutes — Bittensor SN64 serverless inference (RECOMMENDED)
# ~$0.08/scan. Sign up at https://chutes.ai, add credits, copy API key.
CHUTES_API_KEY=your_chutes_api_key
LLM_PROVIDER=chutes

# Option B: Anthropic Claude — direct API
# ~$2.37/scan. Get key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key
# LLM_PROVIDER=anthropic

# ============================================
# SOCIAL DATA SOURCES (Bittensor)
# ============================================

# SN13 — Macrocosmos social data API (gRPC)
# Sign up at https://macrocosmos.ai, get API key from dashboard.
MACROCOSMOS_API_KEY=your_macrocosmos_api_key

# SN22 — Desearch social data API (REST)
# Sign up at https://desearch.ai, get API key from dashboard.
DESEARCH_API_KEY=your_desearch_api_key

# ============================================
# EUROPEAN REGULATORY MONITORING
# ============================================

# UK Companies House API (FREE)
# Register at: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=your_companies_house_api_key

# ============================================
# OPTIONAL
# ============================================

# OpenAI (Whisper transcription, embeddings)
OPENAI_API_KEY=your_openai_api_key

# Telegram (credit event alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Substack email parser
SUBSTACK_EMAIL=your_email@example.com
SUBSTACK_EMAIL_PASSWORD=your_app_password
